<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d9488"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/app_name"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/paywall_tagline"
            android:textColor="#ccfbf1"
            android:textSize="15sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/paywall_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="#1a4b47"
            android:padding="16dp"
            android:text="@string/paywall_description_fallback"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

        <ProgressBar
            android:id="@+id/paywall_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            android:indeterminateTint="#ffffff" />

        <Button
            android:id="@+id/subscribe_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#ffffff"
            android:text="@string/paywall_subscribe"
            android:textColor="#0f766e"
            android:textSize="16sp"
            android:textStyle="bold"
            android:enabled="false" />

        <Button
            android:id="@+id/restore_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@android:color/transparent"
            android:text="@string/paywall_restore"
            android:textColor="#ccfbf1"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#1a4b47" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/paywall_promo_label"
            android:textColor="#ccfbf1"
            android:textSize="13sp"
            android:gravity="center" />

        <EditText
            android:id="@+id/promo_code_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="#1a4b47"
            android:hint="@string/paywall_promo_hint"
            android:textColor="#ffffff"
            android:textColorHint="#4ade80"
            android:textSize="14sp"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:gravity="center" />

        <Button
            android:id="@+id/promo_redeem_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="48dp"
            android:backgroundTint="#0f766e"
            android:text="@string/paywall_promo_redeem"
            android:textColor="#ffffff"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
